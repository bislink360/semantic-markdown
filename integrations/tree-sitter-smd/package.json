{
  "name": "tree-sitter-smd",
  "version": "1.7.0",
  "private": true,
  "description": "Tree-sitter grammar for the Semantic Markdown (.smd) extensions, with highlight, injection, fold and indent queries. Markdown itself is injected from tree-sitter-markdown.",
  "author": "Roshan Alwis",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bislink360/semantic-markdown.git",
    "directory": "integrations/tree-sitter-smd"
  },
  "keywords": [
    "tree-sitter",
    "semantic-markdown",
    "smd",
    "markdown",
    "parser"
  ],
  "files": [
    "grammar.js",
    "tree-sitter.json",
    "queries/*",
    "src/**"
  ],
  "scripts": {
    "generate": "tree-sitter generate --abi 14",
    "test": "tree-sitter test",
    "parse:all": "node scripts/parse-all.mjs"
  },
  "devDependencies": {
    "tree-sitter-cli": "0.27.0"
  }
}
