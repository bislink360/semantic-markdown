{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Semantic Markdown config (smd.config.json / .smdrc)",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "rules": {
      "type": "object",
      "description": "Turn rules off or change their severity, by rule code, category (link/*) or * for all.",
      "properties": {
        "*": {
          "enum": [
            "off",
            "error",
            "warning",
            "info",
            "hint"
          ],
          "description": "Every rule. More specific keys win."
        },
        "frontmatter/*": {
          "enum": [
            "off",
            "error",
            "warning",
            "info",
            "hint"
          ],
          "description": "Every frontmatter/… rule. Exact codes win."
        },
        "container/*": {
          "enum": [
            "off",
            "error",
            "warning",
            "info",
            "hint"
          ],
          "description": "Every container/… rule. Exact codes win."
